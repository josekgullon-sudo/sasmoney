# Todas las variables son opcionales: sin ellas la aplicación funciona igual.

# Puerto donde escucha
PORT=3000

# Carpeta donde se guarda la base de datos (móntala en un disco persistente)
DATA_DIR=./data

# Usuario y contraseña del jefe. Sólo se usan la PRIMERA vez, al crear la base de datos.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto
ADMIN_NAME=Jefe

# Zona horaria del negocio (para saber qué día es "hoy")
TZ_APP=Europe/Madrid

# Pon 1 cuando la sirvas por HTTPS
COOKIE_SECURE=0

# Días que dura la sesión sin tener que volver a entrar
SESSION_DAYS=30
